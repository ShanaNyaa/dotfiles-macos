	path = tmux/.config/tmux/plugins/tpm
	url = https://github.com/tmux-plugins/tpm.git

[submodule "tmux/.config/tmux/plugins/tmux"]
	path = tmux/.config/tmux/plugins/tmux
	url = https://github.com/catppuccin/tmux.git

