	path = tmux/.config/tmux/plugins/tmux-sensible
	url = https://github.com/tmux-plugins/tmux-sensible.git

[submodule "tmux/.config/tmux/plugins/tmux-battery"]
	path = tmux/.config/tmux/plugins/tmux-battery
	url = https://github.com/tmux-plugins/tmux-battery.git

[submodule "tmux/.config/tmux/plugins/tmux-online-status"]
	path = tmux/.config/tmux/plugins/tmux-online-status
	url = https://github.com/tmux-plugins/tmux-online-status.git

[submodule "tmux/.config/tmux/plugins/tmux-resurrect"]
	path = tmux/.config/tmux/plugins/tmux-resurrect
	url = https://github.com/tmux-plugins/tmux-resurrect.git

[submodule "tmux/.config/tmux/plugins/tmux-continuum"]
